# ============================================================
# TROPICAL CYCLONE AI PLATFORM - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- APPLICATION ----
APP_NAME="Tropical Cyclone AI Platform"
APP_ENV=development
DEBUG=true
SECRET_KEY=your-secret-key-here-change-in-production

# ---- DATABASE ----
DATABASE_URL=postgresql://cyclone_user:your_password@localhost:5432/cyclone_db
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=cyclone_db
DATABASE_USER=cyclone_user
DATABASE_PASSWORD=your_password_here

# ---- BACKEND ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---- FRONTEND ----
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Cyclone AI"
NEXT_PUBLIC_MAP_CENTER_LAT=20.0
NEXT_PUBLIC_MAP_CENTER_LON=80.0

# ---- ML MODELS ----
MODEL_BASE_PATH=./models
DETECTION_MODEL_PATH=./models/detection-v1/model.pth
CLASSIFICATION_MODEL_PATH=./models/classification-v1/model.pth
INTENSITY_MODEL_PATH=./models/intensity-v1/model.pth
TRACK_MODEL_PATH=./models/track-v1/model.pth

# ---- DATA ----
DATA_BASE_PATH=./data
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed
LABELS_PATH=./data/labels
METADATA_PATH=./data/metadata

# ---- SATELLITE DATA APIs ----
# MOSDAC (ISRO/SAC) - for INSAT-3D data
MOSDAC_API_KEY=your_mosdac_api_key_here
MOSDAC_BASE_URL=https://mosdac.gov.in/

# NOAA ERDDAP - for HURSAT/GOES data
NOAA_ERDDAP_BASE_URL=https://www.ncei.noaa.gov/erddap/

# NASA EarthData - optional
NASA_EARTHDATA_USERNAME=your_nasa_username
NASA_EARTHDATA_PASSWORD=your_nasa_password

# ---- FILE UPLOAD ----
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_FORMATS=png,jpg,jpeg,tif,tiff,nc,hdf5

# ---- LOGGING ----
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ---- REDIS (optional - for caching) ----
REDIS_URL=redis://localhost:6379/0

# ---- INFERENCE ----
INFERENCE_DEVICE=cpu
# Set to "cuda" if GPU available: INFERENCE_DEVICE=cuda
INFERENCE_BATCH_SIZE=1
MODEL_CACHE_ENABLED=true
